fun @elem(@a: *i32): i32 {
%entry:
 %var_a_0 = alloc *i32
 store @a, %var_a_0
 %0 = load %var_a_0
 %1 = getptr %0, 1
 %2 = load %1
 ret %2
}
fun @row(@a: *[i32, 3]): i32 {
%entry:
 %var_a_1 = alloc *[i32, 3]
 store @a, %var_a_1
 %3 = load %var_a_1
 %4 = getptr %3, 1
 %5 = getelemptr %4, 0
 %6 = call @elem(%5)
 ret %6
}
fun @forward(@a: *[i32, 3]): i32 {
%entry:
 %var_a_2 = alloc *[i32, 3]
 store @a, %var_a_2
 %7 = load %var_a_2
 %8 = call @row(%7)
 ret %8
}
fun @main(): i32 {
%entry:
 %var_b_3 = alloc [[i32, 3], 2]
 %9 = getelemptr %var_b_3, 0
 %10 = getelemptr %9, 0
 store 1, %10
