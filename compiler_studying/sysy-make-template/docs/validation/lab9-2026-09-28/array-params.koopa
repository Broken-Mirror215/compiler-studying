 %17 = getelemptr %var_b_3, 1
 %18 = getelemptr %17, 1
 store 5, %18
 %19 = getelemptr %var_b_3, 1
 %20 = getelemptr %19, 2
 store 6, %20
 %21 = getelemptr %var_b_3, 0
 %22 = call @forward(%21)
 %23 = getelemptr %var_b_3, 0
 %24 = getelemptr %23, 0
 %25 = call @elem(%24)
 %26 = add %22, %25
 ret %26
